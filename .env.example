# Copy to .env.local. These are the same keys as aod.co.in's (its .env.local): the redesign saves
# booking requests to the same Supabase project, sheet and email account.
# Without the Supabase URL and publishable key the booking page runs as a preview: no email code is
# sent, any 6 digits pass and nothing is saved (the page says so).

# Supabase project → Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (same page, "Secret keys"). Server only: never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Emails (resend.com): the team's new-request email and the customer's copy.
RESEND_API_KEY=
EMAIL_FROM=AOD <connect@aod.co.in>
# Where team notifications go (comma-separated; defaults to connect@aod.co.in). Active Admins get them too.
TEAM_EMAIL=

# The orders spreadsheet ("All orders" tab), through a Google service account.
ORDERS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, on one line with \n for line breaks, in double quotes.
GOOGLE_PRIVATE_KEY=

# Google Maps venue suggestions on the booking page (VenueField.tsx). A browser key: restrict it
# to the site addresses (HTTP referrers) and to the Maps JavaScript API, Places API (New) and
# Maps Embed API. Empty: the venue box is plain text.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
